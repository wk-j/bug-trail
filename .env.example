# Copy to .env and fill in. Never commit .env.

# Token agents use to upload trails (bug-trail push). Generate one with: openssl rand -hex 32
BUG_TRAIL_TOKEN=

# Host port for the dashboard.
BUG_TRAIL_PORT=4317

# Interface to publish on. Use 127.0.0.1 behind a reverse proxy on the same host.
BUG_TRAIL_BIND=0.0.0.0

# Image tag / version string shown by `bug-trail version`.
BUG_TRAIL_VERSION=dev
